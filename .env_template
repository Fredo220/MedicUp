# MedicUp configuration — copy to .env and fill in your values

# Nebius Token Factory (required) — https://tokenfactory.nebius.com
NEBIUS_API_KEY=your-token-factory-key

# Tavily web search (optional, used for web context)
TAVILY_API_KEY=tvly-your-key

# OpenAlex polite pool (optional, recommended)
OPENALEX_EMAIL=your-email@example.com
OPENALEX_API_KEY=

# Optional model overrides (any Token Factory model id)
# MEDICUP_SMALL_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# MEDICUP_STRONG_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# MEDICUP_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# Debug mode — logs full LLM requests/responses to logs/llm/
OPENOE_DEBUG=false
