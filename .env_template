# OpenOE-Lite Configuration
# Copy to .env and fill in your values

# LLM API (required) — get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Tavily web search (web discovery route + web context / supporting sources) — https://app.tavily.com
TAVILY_API_KEY=tvly-your-key-here

# OpenAlex polite pool (optional, recommended)
OPENALEX_EMAIL=your-email@example.com

# Debug mode — enables detailed LLM request/response logging to logs/llm/
OPENOE_DEBUG=false

# OpenAlex API key (optional, free): raises the daily request budget — openalex.org → Settings → API key
OPENALEX_API_KEY=
