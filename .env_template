# MedicUp configuration — copy to .env and fill in your values

# Nebius Token Factory (required for chat answers, follow-ups and the LLM judge) — https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# Or mount a private key file and set its path (do not put API keys in chat/source code):
# NEBIUS_API_KEY_FILE=/run/secrets/nebius_api_key

# Tavily web search (web discovery route + web context / supporting sources / figures) — https://app.tavily.com
TAVILY_API_KEY=
# TAVILY_API_KEY_FILE=/run/secrets/tavily_api_key

# OpenAlex polite pool (optional, recommended)
OPENALEX_EMAIL=your-email@example.com
# OpenAlex API key (optional, free): raises the daily request budget — openalex.org → Settings → API key
OPENALEX_API_KEY=

# Optional model overrides (any Token Factory model id)
# MEDICUP_SMALL_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# MEDICUP_STRONG_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# MEDICUP_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# MEDICUP_JUDGE_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Debug mode — logs full LLM requests/responses to logs/llm/
OPENOE_DEBUG=false
